local hwid = ""
pcall(function()
    hwid = gethwid and gethwid() or identifyexecutor and identifyexecutor() or "UnknownDevice"
end)

local lockedFile = "meow_device_lock.txt"
local isAlreadyLocked = false
pcall(function()
    if isfile and isfile(lockedFile) then
        if readfile(lockedFile) == hwid then
            isAlreadyLocked = true
        end
    end
end)

local successGet, rawKeys = pcall(function()
    return game:HttpGet("https://raw.githubusercontent.com/krypticlabx/myloves-/main/04291à196fa0a9m76b630c1y16f86709")
end)

if not successGet then
    game:GetService("Players").LocalPlayer:Kick("\n[MEOW ERROR]\nHindi ma-load ang key database!")
    return
end

local HttpService = game:GetService("HttpService")
local ValidKeys = {}
pcall(function()
    ValidKeys = HttpService:JSONDecode(rawKeys)
end)

local successKey, input_key = pcall(function()
    return getgenv().script_key
end)

pcall(function()
    getgenv().script_key = nil
end)

if not successKey or not input_key or not ValidKeys[input_key] then
    game:GetService("Players").LocalPlayer:Kick("\n[ACCESS DENIED]\nWalang Script Key o Maling Key!")
    return
end

pcall(function()
    if writefile and not isfile(lockedFile) then
        writefile(lockedFile, hwid)
    end
end)

